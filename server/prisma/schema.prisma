generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 用户账号信息：手机号、密码、昵称、对外 user_id
model User {
  id                    String                 @id @default(cuid())
  phone                 String                 @unique
  password              String
  nickname              String
  userId                String                 @unique @map("user_id")
  // 账号状态：active 正常 / disabled 被禁用 / deleted 已注销；后台禁用用户就改这个字段，不再只能改会员和积分
  status                String                 @default("active")
  // 最后登录时间：登录成功时更新，用户活跃分析用；没登录过就是空
  lastLoginAt           DateTime?              @map("last_login_at")
  // 注销时间：软删除标记，注销只写这个时间、不真删行，老订单等历史数据还能对上号
  deletedAt             DateTime?              @map("deleted_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  profile               UserProfile?
  cartItems             CartItem[]
  favorites             Favorite[]
  browseHistory         BrowseHistoryItem[]
  userCoupons           UserCoupon[]
  notifications         Notification[]
  addresses             Address[]
  orders                Order[]
  walletLedgers         WalletLedger[]
  supportConversations  SupportConversation[]
  productReviews        ProductReview[]
  productReviewComments ProductReviewComment[]
  aiArtworks            AiArtwork[]
  aiCommunityPosts      AiCommunityPost[]
  aiCommunityComments   AiCommunityComment[]
  aiCommunityLikes      AiCommunityLike[]
  paymentTransactions   PaymentTransaction[]
  afterSaleRequests     AfterSaleRequest[]
  aiChatConversations   AiChatConversation[]
  guideRecommendations  GuideRecommendation[]

  @@map("user_accounts")
}

/// 用户扩展资料：头像、积分、趣币、VIP、每日任务
model UserProfile {
  userId                     String    @id @map("user_id")
  newcomerClaimed            Boolean   @default(false) @map("newcomer_claimed")
  memberMonthlyCouponClaimed Boolean   @default(false) @map("member_monthly_coupon_claimed")
  points                     Int       @default(0)
  funCoins                   Int       @default(0) @map("fun_coins")
  vipLevel                   Int       @default(1) @map("vip_level")
  avatarPath                 String    @default("") @map("avatar_path")
  dailyCheckInDone           Boolean   @default(false) @map("daily_check_in_done")
  dailyShareDone             Boolean   @default(false) @map("daily_share_done")
  dailyBrowseRewardClaimed   Boolean   @default(false) @map("daily_browse_reward_claimed")
  dailyBrowseCount           Int       @default(0) @map("daily_browse_count")
  pushEnabled                Boolean   @default(true) @map("push_enabled")
  // 个人资料补充：之前资料只有头像和昵称，想做生日礼、编辑资料页都没有字段可存
  gender                     String?
  birthday                   DateTime?
  bio                        String?   @db.Text
  // 成长值：会员升级进度用；vipLevel 是当前等级，growthPoints 是攒了多少，两个分开才能算「离下一级还差多少」
  growthPoints               Int       @default(0) @map("growth_points")
  // 会员到期时间：空 = 不是付费会员或不过期；会员中心显示到期日靠它
  vipExpireAt                DateTime? @map("vip_expire_at")
  // 每日任务所属日期（yyyy-MM-dd，按 Asia/Shanghai 算）：daily* 那几个开关只对这一天有效，
  // 读到时发现不是今天就先清零再判断。没有这个字段，每日签到一辈子只能签一次（旧 bug）。
  dailyDate                  String    @default("") @map("daily_date")
  // 会员每月赠券领取月份（yyyy-MM）：memberMonthlyCouponClaimed 只对这个月有效，跨月自动可再领，规则同 dailyDate
  memberCouponMonth          String    @default("") @map("member_coupon_month")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

/// 商品主表
model Product {
  id                   String                @id
  name                 String
  nameEn               String                @map("name_en")
  price                Decimal               @db.Decimal(10, 2)
  originalPrice        Decimal?              @map("original_price") @db.Decimal(10, 2)
  category             String
  subCategory          String                @map("sub_category")
  majorCategory        String                @map("major_category")
  tag                  String?
  tagColor             String?               @map("tag_color")
  spec                 String?
  description          String                @db.Text
  purchaseNotes        String                @map("purchase_notes") @db.Text
  rating               Decimal               @db.Decimal(3, 1)
  sales                Int                   @default(0)
  stock                Int                   @default(100)
  isOnShelf            Boolean               @default(true) @map("is_on_shelf")
  imagePath            String                @map("image_path")
  // 商品多图：imagePath 仍是主图（老代码和 App 都读它），imagePaths 是详情页轮播的全部图，第一张应与主图一致
  imagePaths           String[]              @default([]) @map("image_paths")
  // 详情长图：详情页「商品介绍」区纵向排列的图文长图组，和轮播多图分开维护；没填就不显示这一段
  detailImages         String[]              @default([]) @map("detail_images")
  // 商品视频路径：没有视频就是空，详情页有值才显示视频位
  videoPath            String?               @map("video_path")
  // 品牌与 IP/系列：潮玩按 IP 找货是刚需，之前只能写进描述文字里、没法筛选
  brand                String?
  series               String?
  // 稀有度：如 普通 / 稀有 / 限量 / 隐藏款，给小豆导购的「稀有收藏」路线和命运牌稀有度用，纯展示文字
  rarity               String?
  // 适合谁/什么场景（给导购的结构化卖点）：如「适合送闺蜜生日、放书桌」，小豆推荐理由优先读它，不再现读长描述现编
  suitableFor          String?               @map("suitable_for") @db.Text
  // 结构化卖点列表：一条一句，如「亚克力高透」「可发光」，详情页卖点区和导购对比都读它
  sellingPoints        String[]              @default([]) @map("selling_points")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  banners              Banner[]
  cartItems            CartItem[]
  favorites            Favorite[]
  browseHistory        BrowseHistoryItem[]
  orderItems           OrderItem[]
  reviews              ProductReview[]
  supportConversations SupportConversation[]
  guideRecommendations GuideRecommendation[]

  @@index([majorCategory])
  @@index([category])
  @@map("shop_products")
}

/// 首页轮播图
model Banner {
  id         String    @id @default(cuid())
  imagePath  String    @map("image_path")
  productId  String    @map("product_id")
  sortOrder  Int       @default(0) @map("sort_order")
  // 轮播标题：后台列表和无障碍读图用，App 首页可不显示
  title      String?
  // 跳转类型：product 跳商品（默认，老数据都是这种）/ category 跳分类 / url 跳外链；非 product 时看 linkTarget
  linkType   String    @default("product") @map("link_type")
  // 跳转目标：category 时存分类名、url 时存链接；product 时为空、用 productId
  linkTarget String?   @map("link_target")
  // 是否启用：关掉只是不展示，不用删了重建
  isActive   Boolean   @default(true) @map("is_active")
  // 生效时间窗：都为空 = 一直生效；活动轮播可预设上下线时间
  startsAt   DateTime? @map("starts_at")
  endsAt     DateTime? @map("ends_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("shop_banners")
}

/// 购物车
model CartItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  // 规格：改为必填、默认空文字。坑：可空字段进唯一约束时数据库把每个空都当不同值，同一商品能加出多行；
  // 用空文字占位后，唯一约束才真的拦得住重复行。没有规格的商品 spec 就是 ""
  spec      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, spec])
  @@map("shop_cart_items")
}

/// 商品收藏
model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("user_favorites")
}

/// 商品浏览记录
model BrowseHistoryItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt(sort: Desc)])
  @@map("user_browse_history")
}

/// 优惠券模板
model CouponTemplate {
  id            String       @id
  title         String
  discount      Decimal      @db.Decimal(10, 2)
  condition     String
  expireAt      DateTime     @map("expire_at")
  claimType     String?      @map("claim_type")
  // 使用门槛金额（满多少可用）：下单算门槛只认这个数字字段。
  // 旧 bug 是从 condition 文字「满30可用」里抠数字，文案一改就可能算错；condition 从此只给人看。
  // 老数据由 seed 和后台保存时回填，服务端读到 0 时仍会兜底解析一次 condition。
  minAmount     Decimal      @default(0) @map("min_amount") @db.Decimal(10, 2)
  // 券类型：fixed 固定金额满减（现在都是这种）/ percent 折扣券（discount 存折扣额度的预留口径，先留字段不启用）
  couponType    String       @default("fixed") @map("coupon_type")
  // 发行总量：空 = 不限量；配合 issuedCount 做「已领完」判断
  totalQuantity Int?         @map("total_quantity")
  // 已领取数量：领券时加 1，服务端维护，禁止后台手改
  issuedCount   Int          @default(0) @map("issued_count")
  // 每人限领次数：默认 1（和用户券的唯一约束一致）；会员月券这类靠领取月份重置，不靠放宽这个数
  perUserLimit  Int          @default(1) @map("per_user_limit")
  // 可领取开始时间：空 = 立刻可领；expireAt 管券本身过期，这个管什么时候开始发
  claimStartAt  DateTime?    @map("claim_start_at")
  // 适用范围：all 全场 / category 限大类 / product 限指定商品，范围值存 scopeValue（分类名或商品 id，多个用逗号隔开）
  scope         String       @default("all")
  scopeValue    String?      @map("scope_value")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  userCoupons   UserCoupon[]
  orders        Order[]

  @@map("shop_coupon_templates")
}

/// 用户已领取的优惠券
model UserCoupon {
  id         String         @id @default(cuid())
  userId     String         @map("user_id")
  templateId String         @map("template_id")
  used       Boolean        @default(false)
  // 使用时间与使用的订单：used 只有真假，客服查「这张券哪笔订单用的」要靠这两个字段；没用就是空
  usedAt     DateTime?      @map("used_at")
  orderId    String?        @map("order_id")
  claimedAt  DateTime       @default(now()) @map("claimed_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  template   CouponTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  order      Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, templateId])
  @@map("user_coupons")
}

/// App 内通知
model Notification {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  title      String
  body       String    @db.Text
  type       String
  read       Boolean   @default(false)
  // 跳转目标：点通知跳哪儿。targetType 如 order / product / coupon，targetId 存对应编号；都为空 = 点了不跳
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  // 已读时间：read 是状态，这个是发生时间，做「未读数」之外的统计时用；未读就是空
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("user_notifications")
}

/// 收货地址
model Address {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  phone     String
  detail    String   @db.Text
  // 省 / 市 / 区：之前全挤在 detail 一个字段里，没法按地区统计、也没法和地址选择器对接。
  // 新字段默认空文字，老地址不回填也不报错；detail 从此只存街道门牌那一段，新建地址时服务端会把省市区拼回展示文字兼容老 App
  province  String   @default("")
  city      String   @default("")
  district  String   @default("")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

/// 订单主表
model Order {
  id                String               @id @default(cuid())
  userId            String               @map("user_id")
  orderNo           String               @unique @map("order_no")
  status            String               @default("pending")
  subtotal          Decimal              @db.Decimal(10, 2)
  discount          Decimal              @default(0) @db.Decimal(10, 2)
  total             Decimal              @db.Decimal(10, 2)
  addressName       String?              @map("address_name")
  addressPhone      String?              @map("address_phone")
  addressDetail     String?              @map("address_detail") @db.Text
  // 用了哪种券：2026-11-20 起补上正式外键（之前只存编号、数据库管不着，券模板删了会留野编号）；
  // 券模板被删时这里自动置空，订单本身和金额快照不受影响
  couponTemplateId  String?              @map("coupon_template_id")
  paymentMethod     String?              @map("payment_method")
  paymentStatus     String               @default("pending") @map("payment_status")
  paidAt            DateTime?            @map("paid_at")
  // 运费：之前总价里分不出运费，对账和「满多少包邮」都没法算；默认 0 = 包邮，total 仍是最终实付（含运费口径不变）
  freight           Decimal              @default(0) @db.Decimal(10, 2)
  // 买家备注：下单时留言，如「放门口」；没留就是空
  remark            String?              @db.Text
  // 取消原因：用户取消或后台取消时写，配合 cancelledAt 看售后分析
  cancelReason      String?              @map("cancel_reason")
  cancelledAt       DateTime?            @map("cancelled_at")
  // 物流三件套 + 两个时间点：之前订单有待发货/待收货状态，却没有快递和发货时间字段，用户查不到包裹
  shippingCompany   String?              @map("shipping_company")
  trackingNo        String?              @map("tracking_no")
  shippedAt         DateTime?            @map("shipped_at")
  receivedAt        DateTime?            @map("received_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponTemplate    CouponTemplate?      @relation(fields: [couponTemplateId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  reviews           ProductReview[]
  payments          PaymentTransaction[]
  afterSaleRequests AfterSaleRequest[]
  usedCoupons       UserCoupon[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("shop_orders")
}

/// 订单明细
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  name      String
  quantity  Int
  // 规格快照：口径和购物车一致，必填默认空文字，理由见 CartItem.spec
  spec      String   @default("")
  // 商品图快照：之前只有名字和单价是快照，商品改图后老订单里的图会跟着变；下单时把主图抄一份存这里
  imagePath String?  @map("image_path")
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@map("shop_order_items")
}

/// 积分/趣币流水
model WalletLedger {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  walletType   String   @map("wallet_type")
  amount       Int
  title        String
  // 关联来源：这笔流水是哪件事产生的。refType 如 order / checkin / redeem，refId 存订单 id 等编号；
  // 之前只有一句 title，客服查账对不上号。系统自动记的流水会带上，手记的可以为空
  refType      String?  @map("ref_type")
  refId        String?  @map("ref_id")
  // 变动后余额：记账那一刻的 points 或 funCoins 余额（按 walletType 分），对账不用再逐笔倒推；老流水为空
  balanceAfter Int?     @map("balance_after")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, walletType, createdAt(sort: Desc)])
  @@map("user_wallet_ledgers")
}

/// 客服会话
model SupportConversation {
  id                 String           @id @default(cuid())
  userId             String           @map("user_id")
  status             String           @default("open")
  subject            String?
  productId          String?          @map("product_id")
  productName        String?          @map("product_name")
  lastMessageAt      DateTime         @default(now()) @map("last_message_at")
  lastMessagePreview String?          @map("last_message_preview")
  unreadAdmin        Int              @default(0) @map("unread_admin")
  unreadUser         Int              @default(0) @map("unread_user")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 关联商品：2026-11-20 起补正式外键（之前只存编号）；商品被删时自动置空，会话和消息保留
  product            Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  messages           SupportMessage[]

  @@index([userId, status, lastMessageAt(sort: Desc)])
  @@index([status, lastMessageAt(sort: Desc)])
  @@map("admin_support_conversations")
}

/// 客服消息
model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String              @map("conversation_id")
  senderRole     String              @map("sender_role")
  senderName     String?             @map("sender_name")
  messageType    String              @default("text") @map("message_type")
  content        String              @db.Text
  mediaUrl       String?             @map("media_url")
  stickerId      String?             @map("sticker_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Asc)])
  @@map("admin_support_messages")
}

/// 商品评价
model ProductReview {
  id               String                 @id @default(cuid())
  userId           String                 @map("user_id")
  productId        String                 @map("product_id")
  orderId          String                 @map("order_id")
  content          String                 @db.Text
  rating           Int                    @default(5)
  imagePaths       String[]               @default([]) @map("image_paths")
  // 审核状态：visible 可见（默认）/ hidden 已隐藏 / pending 待审核。之前没有这个字段，后台想处理一条评价只能删
  moderationStatus String                 @default("visible") @map("moderation_status")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  comments         ProductReviewComment[]

  @@unique([userId, orderId, productId])
  @@index([productId, createdAt(sort: Desc)])
  @@map("shop_product_reviews")
}

/// 商品评价下的楼中楼评论
model ProductReviewComment {
  id              String        @id @default(cuid())
  reviewId        String        @map("review_id")
  userId          String        @map("user_id")
  // 父评论与楼根：2026-11-20 改为可空。旧写法用文字 "0" 冒充「没有父评论」，查楼删楼都要特判这个假编号；
  // 现在顶层评论两个字段就是空。注意：接口返回给 App 时仍转回 "0"，App 那边的老口径不用改
  parentId        String?       @map("parent_id")
  rootId          String?       @map("root_id")
  replyToUserId   String        @default("") @map("reply_to_user_id")
  replyToUserName String        @default("") @map("reply_to_user_name")
  content         String        @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  review          ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt(sort: Asc)])
  @@index([reviewId, rootId, createdAt(sort: Asc)])
  @@map("shop_product_review_comments")
}

/// AI 绘画作品
model AiArtwork {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  prompt           String   @db.Text
  style            String   @default("")
  imagePath        String   @map("image_path")
  model            String   @default("wan2.7-image")
  // 审核状态：口径同 ProductReview.moderationStatus，AI 生成图更需要能隐藏
  moderationStatus String   @default("visible") @map("moderation_status")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_artworks")
}

/// AI 角色配置
model AiFriend {
  id           String               @id
  name         String
  avatarPath   String               @default("") @map("avatar_path")
  avatarColor  String               @default("#A389F4") @map("avatar_color")
  systemPrompt String               @map("system_prompt") @db.Text
  sortOrder    Int                  @default(0) @map("sort_order")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  posts        AiCommunityPost[]
  comments     AiCommunityComment[]
  likes        AiCommunityLike[]

  @@map("ai_friends")
}

/// AI 社区动态
model AiCommunityPost {
  id               String               @id @default(cuid())
  authorType       String               @map("author_type")
  userId           String?              @map("user_id")
  aiFriendId       String?              @map("ai_friend_id")
  content          String               @db.Text
  imagePath        String               @default("") @map("image_path")
  imagePaths       String[]             @default([]) @map("image_paths")
  // 审核状态：口径同 ProductReview.moderationStatus；隐藏的动态 App 列表不再返回
  moderationStatus String               @default("visible") @map("moderation_status")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  user             User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiFriend         AiFriend?            @relation(fields: [aiFriendId], references: [id], onDelete: Cascade)
  comments         AiCommunityComment[]
  likes            AiCommunityLike[]

  @@index([createdAt(sort: Desc)])
  @@map("ai_community_posts")
}

/// AI 社区评论
model AiCommunityComment {
  id              String          @id @default(cuid())
  postId          String          @map("post_id")
  authorType      String          @map("author_type")
  userId          String?         @map("user_id")
  aiFriendId      String?         @map("ai_friend_id")
  // 父评论与楼根：改为可空，理由和改法同 ProductReviewComment（接口对 App 仍返回 "0"）
  parentId        String?         @map("parent_id")
  rootId          String?         @map("root_id")
  replyToUserId   String          @default("") @map("reply_to_user_id")
  replyToUserName String          @default("") @map("reply_to_user_name")
  content         String          @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  post            AiCommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiFriend        AiFriend?       @relation(fields: [aiFriendId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt(sort: Asc)])
  @@index([postId, rootId, createdAt(sort: Asc)])
  @@map("ai_community_comments")
}

/// AI 社区点赞
model AiCommunityLike {
  id         String          @id @default(cuid())
  postId     String          @map("post_id")
  likerKey   String          @map("liker_key")
  userId     String?         @map("user_id")
  aiFriendId String?         @map("ai_friend_id")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  post       AiCommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiFriend   AiFriend?       @relation(fields: [aiFriendId], references: [id], onDelete: Cascade)

  @@unique([postId, likerKey])
  @@map("ai_community_likes")
}

/// 支付流水：一笔订单每次支付动作一行，和订单分开存
/// 之前支付方式只是订单上的一个文字字段、还写死 mock（模拟支付），真接支付时交易号、回调状态都没地方存
model PaymentTransaction {
  id            String    @id @default(cuid())
  orderId       String    @map("order_id")
  userId        String    @map("user_id")
  // 支付方式：mock 模拟 / wechat 微信 / alipay 支付宝，取值对照见 server/src/utils/status-values.js
  method        String
  // 第三方交易号：模拟支付时由服务端生成一个 MOCK 开头的编号占位；唯一，回调对账靠它
  transactionNo String    @unique @map("transaction_no")
  amount        Decimal   @db.Decimal(10, 2)
  // 支付状态：pending 待支付 / paid 已支付 / failed 失败 / refunded 已退款
  status        String    @default("pending")
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("shop_payment_transactions")
}

/// 售后申请：退款/退货走这张表，不再把「已取消」混在售后里
model AfterSaleRequest {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  userId      String   @map("user_id")
  // 类型：refund 仅退款 / return 退货退款
  type        String   @default("refund")
  reason      String
  description String   @default("") @db.Text
  // 申请退款金额：为空 = 按订单实付全额退，由服务端在审核时核定
  amount      Decimal? @db.Decimal(10, 2)
  // 状态：pending 待处理 / approved 已同意 / rejected 已拒绝 / completed 已完成
  status      String   @default("pending")
  // 后台处理备注：拒绝原因等写这里，用户可见
  adminNote   String?  @map("admin_note")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("shop_after_sale_requests")
}

/// 小豆聊天会话：之前 /api/chat 完全不落库，聊天历史只在手机本地，换手机就没了
model AiChatConversation {
  id        String          @id @default(cuid())
  userId    String          @map("user_id")
  // 会话标题：默认取第一句用户消息的前一段文字，可为空
  title     String          @default("")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiChatMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("ai_chat_conversations")
}

/// 小豆聊天消息：一行一条，role 区分 user / assistant
model AiChatMessage {
  id             String             @id @default(cuid())
  conversationId String             @map("conversation_id")
  role           String
  content        String             @db.Text
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  conversation   AiChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Asc)])
  @@map("ai_chat_messages")
}

/// 星愿导购推荐记录：小豆每推荐一件商品记一行，以后优化导购、统计「推荐了什么、买没买」靠它
/// 之前推荐只出现在聊天里、聊完就扔，命运三翻抽过什么都没记录
model GuideRecommendation {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  // 来源会话：从聊天里推的就记会话 id，今日星签等场景没有会话就为空（只存编号，不建外键，避免会话删了记录跟着没）
  conversationId String?  @map("conversation_id")
  // 用户当时说的话（需求原文）：复盘推荐准不准时要看输入，只存这一句，不存整段聊天
  requestText    String   @default("") @map("request_text") @db.Text
  productId      String?  @map("product_id")
  // 分岔路口路线：性价比 / 实用 / 体验 / 稀有 等路线名，没走路线就是空
  route          String?
  // 推荐理由：当时给用户看的那一句理由原文存下来，不要事后重算
  reason         String   @default("") @db.Text
  // 在这一批推荐里的名次：1 是第一张牌
  rank           Int      @default(0)
  // 结果：recommended 已推荐 / clicked 已点开 / ordered 已下单 / dismissed 换一批刷掉；下单时服务端会把同商品的记录标成 ordered
  outcome        String   @default("recommended")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([productId])
  @@map("ai_guide_recommendations")
}
